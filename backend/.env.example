APP_ENV=development
DATABASE_URL=postgresql+psycopg://edumind:local-development-only@localhost:5432/edumind
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
JWT_ISSUER=edumind-api
JWT_AUDIENCE=edumind-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
COOKIE_SAMESITE=lax

# Phase 4 storage/context controls. These settings do not enable a test/live AI provider.
CHAT_USER_LIMIT=20
CHAT_TIMEOUT_SECONDS=20
CHAT_CONTEXT_CHARACTERS=24000

# Backend only. Never use VITE_ for credentials. Empty key keeps AI disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ATTEMPTS=3
GEMINI_TIMEOUT_SECONDS=15
